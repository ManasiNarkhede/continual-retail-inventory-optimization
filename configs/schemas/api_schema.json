{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["api", "models"],
  "properties": {
    "api": {
      "type": "object",
      "required": ["host", "port", "workers", "reload", "log_level", "allowed_origins", "title", "version"],
      "properties": {
        "host": { "type": "string", "minLength": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "workers": { "type": "integer", "minimum": 1 },
        "reload": { "type": "boolean" },
        "log_level": {
          "type": "string",
          "enum": ["critical", "error", "warning", "info", "debug", "trace"]
        },
        "allowed_origins": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "title": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "models": {
      "type": "object",
      "required": [
        "tft_checkpoint",
        "processed_data",
        "runtime_config",
        "rl_checkpoint",
        "cl_metrics",
        "cache_ttl_seconds",
        "forecast_interval_scale",
        "forecast_warmup_top_n",
        "forecast_warmup_horizon",
        "model_version"
      ],
      "properties": {
        "tft_checkpoint": { "type": "string", "minLength": 1 },
        "processed_data": { "type": "string", "minLength": 1 },
        "runtime_config": { "type": "string", "minLength": 1 },
        "rl_checkpoint": { "type": "string", "minLength": 1 },
        "cl_metrics": { "type": "string", "minLength": 1 },
        "cache_ttl_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "forecast_interval_scale": { "type": "number", "minimum": 1 },
        "forecast_warmup_top_n": { "type": "integer", "minimum": 0 },
        "forecast_warmup_horizon": { "type": "integer", "minimum": 1 },
        "model_version": { "type": "string", "minLength": 1 }
      }
    },
    "cors": {
      "type": "object",
      "properties": {
        "allow_origins": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
